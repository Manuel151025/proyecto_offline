DB_PASS=password_seguro_aqui
MYSQL_ROOT_PASS=root_password_aqui
ADMIN_PASSWORD=password_admin_aqui

# Orígenes autorizados para CORS, separados por comas y SIN barra final.
# Cualquier origen fuera de esta lista no recibe cabecera Allow-Origin.
ALLOWED_ORIGINS=https://encuestas.manuelcardenas.online,http://localhost:8898

# Correo para «¿Olvidaste tu contraseña?». Con Gmail: una contraseña de
# aplicación de 16 letras (myaccount.google.com/apppasswords), sin espacios.
# Paso a paso en docs/DESPLIEGUE.md. Si se deja vacío, la app indica que se
# pida el cambio al administrador.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=tu_cuenta@gmail.com
SMTP_CLAVE=abcdefghijklmnop
SMTP_REMITENTE=tu_cuenta@gmail.com
SMTP_NOMBRE=ColOffline
