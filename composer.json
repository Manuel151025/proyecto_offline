{
    "name": "manuel151025/proyecto-offline-api",
    "description": "API REST de ColOffline, sistema de encuestas demográficas offline-first",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "analizar": "phpstan analyse",
        "sintaxis": "find api -name '*.php' -exec php -l {} \\;"
    },
    "config": {
        "sort-packages": true
    }
}
